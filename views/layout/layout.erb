<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page_title || 'SolCRM' %></title>
  
  <!-- Fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Iconos Lucide -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  
  <!-- Tu CSS unificado -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <div id="scrim"></div>

  <!-- ================= SIDEBAR (Cargado desde partial) ================= -->
  <%= erb :"layout/partials/_sidebar", layout: false %>

  <!-- ================= MAIN ================= -->
  <div class="content">
    <header class="topbar">
      <button class="tb-btn" id="burger"><i data-lucide="menu"></i></button>
      
      <label class="searchbar">
        <i data-lucide="search"></i>
        <input id="globalSearch" placeholder="Buscar…" autocomplete="off">
        <span class="kbd">Ctrl K</span>
      </label>
      
      <div class="tb-right">
        <button class="tb-round" id="themeBtn" title="Cambiar tema"><i data-lucide="moon"></i></button>
        
        <div class="tb-user" id="userWrap">
          <button class="avatar" id="avatarBtn" title="<%= current_user_name %>">
            <%= current_user_name[0].upcase %>
          </button>
          
          <div class="user-menu" id="userMenu">
            <div class="um-head">
              <span class="avatar"><%= current_user_name[0].upcase %></span>
              <div>
                <b><%= current_user_name %></b>
                <span>admin@solcrm.com</span>
              </div>
            </div>
            <a href="/logout" class="um-item" style="text-decoration: none; color: var(--t-red);">
              <i data-lucide="log-out"></i> Cerrar sesión
            </a>
          </div>
        </div>
      </div>
    </header>
    
    <!-- AQUÍ SE INYECTA EL CONTENIDO ESPECÍFICO DE CADA VISTA -->
    <main id="main" class="page">
      <%= yield %>
    </main>
  </div>

  <div id="toasts"></div>

  <!-- ================= SCRIPTS GLOBALES DEL LAYOUT ================= -->
  <script>
    // 1. Inicializar iconos Lucide
    function initIcons() {
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }
    document.addEventListener('DOMContentLoaded', initIcons);

    // 2. Toggle Sidebar en móvil
    const burger = document.getElementById('burger');
    const sideClose = document.getElementById('sideClose');
    const scrim = document.getElementById('scrim');
    
    function toggleSidebar() { document.body.classList.toggle('side-open'); }
    if(burger) burger.addEventListener('click', toggleSidebar);
    if(sideClose) sideClose.addEventListener('click', toggleSidebar);
    if(scrim) scrim.addEventListener('click', toggleSidebar);

    // 3. Toggle Menú de Usuario (Avatar)
    const avatarBtn = document.getElementById('avatarBtn');
    const userMenu = document.getElementById('userMenu');
    const userWrap = document.getElementById('userWrap');

    if(avatarBtn) {
      avatarBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        userMenu.classList.toggle('open');
      });
    }
    
    document.addEventListener('click', (e) => {
      if (userWrap && !userWrap.contains(e.target)) {
        userMenu.classList.remove('open');
      }
    });

    // 4. Lógica del Acordeón del Sidebar (Solo un menú abierto a la vez)
    window.toggleMenuGroup = function(button) {
      const clickedGroup = button.parentElement;
      const isOpen = clickedGroup.classList.contains('open');
      
      // Cerrar TODOS los grupos primero
      document.querySelectorAll('.menu-group').forEach(group => {
        group.classList.remove('open');
      });
      
      // Si el que se clickeó no estaba abierto, abrirlo
      if (!isOpen) {
        clickedGroup.classList.add('open');
      }
    };

    // 5. Cerrar sidebar móvil al hacer clic en un sub-item (Mejora UX)
    document.addEventListener('click', (e) => {
      if (e.target.closest('.sub-item') && window.innerWidth <= 1023) {
        document.body.classList.remove('side-open');
      }
    });
  </script>
</body>
</html>