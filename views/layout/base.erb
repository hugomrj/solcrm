<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page_title || 'SolCRM' %></title>
  
  <!-- Anti-FOUC: aplica el tema antes del primer paint  -->
  <script>
    (function() {
      var saved = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'dark' || (!saved && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>


  <!-- Fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Iconos Lucide -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  
  <!-- Tu CSS unificado -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <!-- Fondo oscuro para móvil cuando el sidebar está abierto -->
  <div id="scrim"></div>

  <!-- ================= SIDEBAR ================= -->
  <%= erb :"layout/partials/_sidebar", layout: false %>

  <!-- ================= MAIN CONTENT ================= -->
  <div class="content">
    
    <!-- ✅ AQUÍ CARGAMOS EL TOPBAR DESDE SU PROPIO ARCHIVO PARCIAL -->
    <%= erb :"layout/partials/_topbar", layout: false %>
    
    <!-- AQUÍ SE INYECTA EL CONTENIDO ESPECÍFICO DE CADA VISTA (Dashboard, Clientes, etc.) -->
    <main id="main" class="page">
      <%= yield %>
    </main>
  </div>


  <!-- ================= MODAL DE CONFIRMACIÓN ================= -->
  <div id="confirmModal" class="modal-backdrop">
    <div class="modal">
      <div class="modal-head">
        <div class="modal-icon" id="confirmIcon">
          <i data-lucide="alert-triangle"></i>
        </div>
        <div>
          <h3 id="confirmTitle">¿Estás seguro?</h3>
          <p id="confirmMessage">Esta acción no se puede deshacer.</p>
        </div>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" id="confirmCancel">Cancelar</button>
        <button type="button" class="btn btn-primary" id="confirmOk">Confirmar</button>
      </div>
    </div>
  </div>






  <!-- ================= TOASTS Y FLASH MESSAGES ================= -->
  <div id="toasts">
    <%= render_flash %>
  </div>

    <!-- ================= SCRIPTS GLOBALES ================= -->
    <script src="/js/app.js" defer></script>
    <script src="/js/vanilla-select.js" defer></script>



</body>
</html>