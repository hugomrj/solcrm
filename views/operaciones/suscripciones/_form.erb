<a href="<%= t('/suscripciones') %>" class="backlink">
  <i data-lucide="arrow-left"></i> Volver a suscripciones
</a>

<div class="page-head">
  <div>
    <h1><%= @page_title %></h1>
    <p class="sub">Datos del plan recurrente</p>
  </div>
</div>

<form method="post" action="<%= @suscripcion ? t("/suscripciones/#{@suscripcion[:id]}") : t('/suscripciones') %>">
  <div class="card form-card">
    <div class="form-grid">

      <div class="field">
        <label>Cliente *</label>
        <select name="cliente_id" class="vanilla-select" required>
          <option value="">— Elegir —</option>
          <% @clientes.each do |c| %>
            <option value="<%= c[:id] %>" <%= 'selected' if @suscripcion && @suscripcion[:cliente_id] == c[:id] %>><%= c[:nombre] %></option>
          <% end %>
        </select>
      </div>

      <div class="field">
        <label for="plan">Plan *</label>
        <input type="text" id="plan" name="plan" required
               value="<%= @suscripcion ? @suscripcion[:plan] : '' %>"
               placeholder="Ej: POS mensual">
      </div>

      <div class="field">
        <label for="monto">Monto (₲) *</label>
        <input type="number" id="monto" name="monto" min="0.01" step="0.01" required
               value="<%= @suscripcion ? numero_input(@suscripcion[:monto]) : '' %>" placeholder="0">
      </div>

      <div class="field">
        <label>Periodicidad</label>
        <select name="periodicidad" class="vanilla-select">
          <% SuscripcionesRoutes::PERIODICIDADES.each do |p| %>
            <option value="<%= p %>" <%= 'selected' if (@suscripcion ? @suscripcion[:periodicidad] : 'mensual') == p %>><%= p.capitalize %></option>
          <% end %>
        </select>
      </div>

      <div class="field">
        <label for="fecha_inicio">Fecha de inicio</label>
        <input type="date" id="fecha_inicio" name="fecha_inicio"
               value="<%= @suscripcion ? @suscripcion[:fecha_inicio] : Date.today %>">
      </div>

      <div class="field">
        <label for="fecha_fin">Fecha de fin</label>
        <input type="date" id="fecha_fin" name="fecha_fin"
               value="<%= @suscripcion && @suscripcion[:fecha_fin] ? @suscripcion[:fecha_fin] : '' %>">
      </div>

      <% if @suscripcion %>
        <div class="field">
          <label>Estado</label>
          <select name="estado" class="vanilla-select">
            <% SuscripcionesRoutes::ESTADOS.each do |e| %>
              <option value="<%= e %>" <%= 'selected' if @suscripcion[:estado] == e %>><%= e.capitalize %></option>
            <% end %>
          </select>
        </div>
      <% end %>

    </div>

    <div class="form-foot">
      <a href="<%= t('/suscripciones') %>" class="btn btn-ghost">Cancelar</a>
      <div class="spacer"></div>
      <button type="submit" class="btn btn-primary">
        <%= @suscripcion ? 'Guardar cambios' : 'Crear suscripción' %>
      </button>
    </div>
  </div>
</form>
