<div class="page-head">
  <div>
    <h1>Panel de Control</h1>
    <p class="sub">Resumen comercial y operativo · últimos 6 meses</p>
  </div>
  <div class="head-actions" style="display:flex;gap:8px">
    <a href="<%= t('/informes_ventas') %>" class="btn btn-ghost"><i data-lucide="trending-up"></i> Informe de ventas</a>
    <a href="<%= t('/ventas/facturas/nuevo') %>" class="btn btn-primary"><i data-lucide="plus"></i> Nueva factura</a>
  </div>
</div>

<div class="stats">
  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-brand"><i data-lucide="trending-up"></i></span>
      <span>Facturado este mes</span>
    </div>
    <div class="big">₲ <%= number_with_delimiter(@facturado_mes) %></div>
    <div class="delta" style="color:var(--text-3)"><%= Date.today.strftime("%B %Y") %></div>
  </div>

  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-green"><i data-lucide="credit-card"></i></span>
      <span>Cobrado este mes</span>
    </div>
    <div class="big">₲ <%= number_with_delimiter(@cobrado_mes) %></div>
    <div class="delta" style="color:var(--text-3)">
      <%= @facturado_mes > 0 ? ((@cobrado_mes / @facturado_mes) * 100).round(1) : 0 %>% del facturado
    </div>
  </div>

  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-warn"><i data-lucide="clock"></i></span>
      <span>Por cobrar</span>
    </div>
    <div class="big">₲ <%= number_with_delimiter(@por_cobrar) %></div>
    <div class="delta" style="color:var(--text-3)"><%= @facturas_por_cobrar %> factura(s) emitida(s)</div>
  </div>

  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-red"><i data-lucide="arrow-down-circle"></i></span>
      <span>Gastos este mes</span>
    </div>
    <div class="big">₲ <%= number_with_delimiter(@gastos_mes) %></div>
    <div class="delta" style="color:var(--text-3)">egresos registrados</div>
  </div>

  <div class="card stat">
    <div class="top">
      <span class="mi-ic <%= @resultado_mes >= 0 ? 'ic-green' : 'ic-red' %>"><i data-lucide="wallet"></i></span>
      <span>Resultado del mes</span>
    </div>
    <div class="big" style="color:<%= @resultado_mes >= 0 ? 'var(--t-green)' : 'var(--t-red)' %>">
      ₲ <%= number_with_delimiter(@resultado_mes) %>
    </div>
    <div class="delta" style="color:var(--text-3)">cobrado − gastos</div>
  </div>
</div>

<div class="dash-grid" style="margin-bottom:16px">
  <div class="card">
    <div class="card-h">
      <span>Facturación vs. cobranza</span>
      <a href="<%= t('/informes_ventas') %>" class="view-all">Ver informe →</a>
    </div>
    <div style="padding:16px 22px 8px">
      <div style="display:flex;align-items:flex-end;gap:10px;height:190px">
        <% @por_mes.each do |m| %>
          <% hf = (m[:facturado] / @max_mes * 100).round(1) %>
          <% hc = (m[:cobrado] / @max_mes * 100).round(1) %>
          <div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:100%;gap:6px;min-width:0">
            <div style="display:flex;align-items:flex-end;gap:3px;height:100%">
              <div title="Facturado <%= m[:etiqueta] %>: ₲ <%= number_with_delimiter(m[:facturado]) %>"
                   style="flex:1;height:<%= hf %>%;background:var(--brand);border-radius:4px 4px 0 0;min-height:2px;opacity:.9"></div>
              <div title="Cobrado <%= m[:etiqueta] %>: ₲ <%= number_with_delimiter(m[:cobrado]) %>"
                   style="flex:1;height:<%= hc %>%;background:var(--green);border-radius:4px 4px 0 0;min-height:2px;opacity:.9"></div>
            </div>
            <div class="sub" style="font-size:11px;text-align:center;white-space:nowrap"><%= m[:etiqueta] %></div>
          </div>
        <% end %>
      </div>
      <div style="display:flex;gap:18px;margin-top:12px">
        <span class="sub" style="display:flex;align-items:center;gap:6px">
          <i style="width:10px;height:10px;border-radius:3px;background:var(--brand);display:inline-block"></i> Facturado
        </span>
        <span class="sub" style="display:flex;align-items:center;gap:6px">
          <i style="width:10px;height:10px;border-radius:3px;background:var(--green);display:inline-block"></i> Cobrado
        </span>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-h">
      <span>Gastos por categoría</span>
      <a href="<%= t('/informes_gastos') %>" class="view-all">Ver informe →</a>
    </div>
    <% if @total_gastos_6m <= 0 %>
      <div class="empty" style="padding:40px 20px">
        <i data-lucide="receipt"></i>
        <b>Sin gastos en 6 meses</b>
        <p>Cargá gastos para ver el desglose</p>
      </div>
    <% else %>
      <% acumulado = 0.0 %>
      <% stops = @gastos_categorias.map { |g| ini = acumulado; acumulado += g[:pct]; "#{g[:color]} #{ini.round(1)}% #{acumulado.round(1)}%" } %>
      <div style="display:flex;gap:22px;align-items:center;padding:18px 22px;flex-wrap:wrap">
        <div style="position:relative;width:150px;height:150px;flex:0 0 auto">
          <div style="position:absolute;inset:0;border-radius:50%;background:conic-gradient(<%= stops.join(', ') %>)"></div>
          <div style="position:absolute;inset:32px;border-radius:50%;background:var(--surface);display:grid;place-items:center;text-align:center">
            <div>
              <div style="font-size:11px;color:var(--text-3)">Total</div>
              <b style="font-size:13px">₲ <%= number_with_delimiter(@total_gastos_6m) %></b>
            </div>
          </div>
        </div>
        <div style="flex:1;min-width:190px">
          <% @gastos_categorias.each do |g| %>
            <div style="display:flex;align-items:center;gap:8px;padding:4px 0;font-size:13px">
              <i style="width:10px;height:10px;border-radius:3px;background:<%= g[:color] %>;display:inline-block;flex:0 0 auto"></i>
              <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= g[:categoria] %></span>
              <span class="sub" style="font-variant-numeric:tabular-nums">₲ <%= number_with_delimiter(g[:monto]) %></span>
              <span class="sub" style="min-width:42px;text-align:right"><%= g[:pct] %>%</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="dash-grid" style="margin-bottom:16px">
  <div class="card">
    <div class="card-h">
      <span>Pipeline por etapa</span>
      <a href="<%= t('/pipeline') %>" class="view-all">Ver pipeline →</a>
    </div>
    <div style="padding:14px 22px 18px">
      <div class="sub" style="margin-bottom:12px">
        <%= @ops_abiertas_count %> oportunidad(es) abiertas · ₲ <%= number_with_delimiter(@total_pipeline) %> en juego
      </div>
      <% if @pipeline.empty? || @total_pipeline <= 0 %>
        <p class="sub" style="margin:0">No hay oportunidades abiertas.</p>
      <% else %>
        <% @pipeline.each do |p| %>
          <div style="margin-bottom:12px">
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px">
              <span><b><%= p[:nombre] %></b> <span class="sub">· <%= p[:count] %></span></span>
              <span class="sub" style="font-variant-numeric:tabular-nums">₲ <%= number_with_delimiter(p[:monto]) %></span>
            </div>
            <div style="height:8px;background:var(--border);border-radius:999px;overflow:hidden">
              <div style="height:100%;width:<%= (p[:monto] / @max_pipeline * 100).round(1) %>%;background:var(--brand);border-radius:999px"></div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-h">
      <span>Top clientes</span>
      <a href="<%= t('/clientes') %>" class="view-all">Ver clientes →</a>
    </div>
    <div style="padding:14px 22px 18px">
      <% if @top_clientes.empty? %>
        <p class="sub" style="margin:0">Sin facturación en los últimos 6 meses.</p>
      <% else %>
        <% @top_clientes.each do |t| %>
          <div style="margin-bottom:12px">
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px">
              <span><b><%= t[:cliente] ? t[:cliente][:nombre] : '—' %></b></span>
              <span class="sub" style="font-variant-numeric:tabular-nums">₲ <%= number_with_delimiter(t[:monto]) %></span>
            </div>
            <div style="height:8px;background:var(--border);border-radius:999px;overflow:hidden">
              <div style="height:100%;width:<%= (t[:monto] / @max_cliente * 100).round(1) %>%;background:var(--purple);border-radius:999px"></div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="dash-grid" style="margin-bottom:16px">
  <div class="card">
    <div class="card-h">
      <span>Últimas facturas</span>
      <a href="<%= t('/ventas/facturas') %>" class="view-all">Ver todas →</a>
    </div>
    <div class="card-b">
      <% if @ultimas_facturas.empty? %>
        <div class="empty" style="padding:30px 20px">
          <i data-lucide="file-text"></i>
          <b>Sin facturas</b>
        </div>
      <% else %>
        <% @ultimas_facturas.each do |f| %>
          <% cli = @facturas_clientes[f[:cliente_id]] %>
          <a href="<%= t("/ventas/facturas/#{f[:id]}") %>" class="mini-row" style="text-decoration:none;color:inherit">
            <span class="mi-ic ic-brand"><i data-lucide="file-check"></i></span>
            <div class="grow">
              <b><%= f[:numero] %></b>
              <span><%= cli ? cli[:nombre] : '—' %> · <%= f[:fecha] %></span>
            </div>
            <div style="text-align:right">
              <b style="font-size:13px;font-variant-numeric:tabular-nums">₲ <%= number_with_delimiter(f[:total]) %></b>
              <% badge = { "borrador"=>"b-gray","emitida"=>"b-blue","pagada"=>"b-green","anulada"=>"b-red" }[f[:estado]] || "b-gray" %>
              <div><span class="badge <%= badge %>"><%= f[:estado] %></span></div>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-h">
      <span>Tickets abiertos</span>
      <a href="<%= t('/soporte') %>" class="view-all">Ver soporte →</a>
    </div>
    <div class="card-b">
      <% if @tickets_recientes.empty? %>
        <div class="empty" style="padding:30px 20px">
          <i data-lucide="life-buoy"></i>
          <b>Sin tickets abiertos</b>
        </div>
      <% else %>
        <% @tickets_recientes.each do |tk| %>
          <a href="<%= t("/soporte/#{tk[:id]}") %>" class="mini-row" style="text-decoration:none;color:inherit">
            <span class="mi-ic <%= tk[:prioridad] == 'urgente' ? 'ic-red' : 'ic-warn' %>"><i data-lucide="life-buoy"></i></span>
            <div class="grow">
              <b><%= tk[:numero] %></b>
              <span><%= tk[:asunto] %></span>
            </div>
            <span class="badge <%= tk[:estado] == 'abierto' ? 'b-blue' : 'b-warn' %>"><%= tk[:estado].tr('_', ' ') %></span>
          </a>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-h">
    <span>Próximas actividades</span>
    <a href="<%= t('/tareas') %>" class="view-all">Ver todas →</a>
  </div>
  <div class="card-b">
    <% if @proximas_actividades.empty? %>
      <div class="empty" style="padding:30px 20px">
        <i data-lucide="calendar-check"></i>
        <b>No hay actividades pendientes</b>
        <p>Todo al día</p>
      </div>
    <% else %>
      <% @proximas_actividades.each do |a| %>
        <div class="mini-row">
          <span class="mi-ic ic-purple"><i data-lucide="calendar-check"></i></span>
          <div class="grow">
            <b><%= a[:titulo] %></b>
            <span><%= a[:tipo].capitalize %> · <%= a[:fecha] ? a[:fecha].strftime("%d/%m %H:%M") : 'sin fecha' %></span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
