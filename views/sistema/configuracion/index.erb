<div class="page-head">
  <div>
    <h1>Configuración</h1>
    <p class="sub">Datos de la empresa</p>
  </div>
</div>

<form method="post" action="<%= t('/configuracion') %>">
  <div class="card form-card">
    <div class="form-grid">

      <div class="field">
        <label>Código (URL)</label>
        <input type="text" value="<%= @empresa[:codigo] %>" disabled>
        <span class="msg"></span>
      </div>

      <div class="field">
        <label>Plan</label>
        <select name="plan" class="vanilla-select">
          <% ConfiguracionRoutes::PLANES.each do |p| %>
            <option value="<%= p %>" <%= 'selected' if @empresa[:plan] == p %>><%= p.capitalize %></option>
          <% end %>
        </select>
      </div>

      <div class="field span2">
        <label for="nombre">Nombre de la empresa *</label>
        <input type="text" id="nombre" name="nombre" required value="<%= @empresa[:nombre] %>">
      </div>

    </div>

    <div class="form-foot">
      <div class="spacer"></div>
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
  </div>
</form>

<div class="card" style="margin-top:16px; padding:20px 24px">
  <h3 style="margin:0 0 8px; font-size:14px">Acceso</h3>
  <p class="sub" style="margin:0 0 6px">La URL de tu empresa es <code>/<%= @empresa[:codigo] %></code> y no se puede cambiar desde acá.</p>
  <p class="sub" style="margin:0">Estado de la cuenta: <span class="badge <%= @empresa[:activo] ? 'b-green' : 'b-red' %>"><%= @empresa[:activo] ? 'activa' : 'inactiva' %></span></p>
</div>
