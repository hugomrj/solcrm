<div class="page-head">
  <div>
    <h1>Bienvenido a SolCRM</h1>
    <p class="sub">Esto es lo que ocurre hoy en tu espacio de trabajo.</p>
  </div>
</div>

<div class="stats">
  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-brand"><i data-lucide="users"></i></span>
      <span>Clientes Potenciales</span>
    </div>
    <div class="big num">0</div>
    <div class="delta">Sin datos aún</div>
  </div>
  
  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-blue"><i data-lucide="star"></i></span>
      <span>Negocios Abiertos</span>
    </div>
    <div class="big num">0</div>
    <div class="delta">Próximamente</div>
  </div>

  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-green"><i data-lucide="circle-dollar-sign"></i></span>
      <span>Valor del Pipeline</span>
    </div>
    <div class="big num">$0</div>
    <div class="delta">Próximamente</div>
  </div>

  <div class="card stat">
    <div class="top">
      <span class="mi-ic ic-purple"><i data-lucide="message-circle"></i></span>
      <span>Mensajes sin leer</span>
    </div>
    <div class="big num">0</div>
    <div class="delta">Conexión pendiente</div>
  </div>
</div>

<div class="dash-grid">
  <div class="card">
    <div class="card-h">
      Últimos Clientes
      <a href="/clientes" class="view-all">Ver todos</a>
    </div>
    <div class="mini-table">
      <div class="empty" style="padding: 30px;">
        <i data-lucide="inbox" style="width: 24px; height: 24px; margin-bottom: 8px;"></i>
        <p style="font-size: 13px; color: var(--text-3);">Aún no hay clientes registrados.</p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-h">
      Próximas Tareas
      <a href="#" class="view-all">Ver todas</a>
    </div>
    <div class="mini-table">
      <div class="empty" style="padding: 30px;">
        <i data-lucide="check-circle-2" style="width: 24px; height: 24px; margin-bottom: 8px;"></i>
        <p style="font-size: 13px; color: var(--text-3);">No hay tareas pendientes.</p>
      </div>
    </div>
  </div>
</div>