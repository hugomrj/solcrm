<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <!-- Inyectamos el CSS directamente desde el sistema de archivos -->
  <style>
    <%= File.read(File.join(settings.root, "public/css/styles.css")) %>
  </style>
  <style>
    body { background: #fff !important; color: #000 !important; padding: 20px; }
    .card { border: none !important; box-shadow: none !important; padding: 0 !important; background: #fff !important; }
  </style>
</head>
<body>

  <!-- Encabezado -->
  <div style="display: table; width: 100%; margin-bottom: 30px; border-bottom: 2px solid #000; padding-bottom: 10px;">
    <div style="display: table-cell; width: 50%;">
      <h2 style="margin: 0; font-size: 24px;">SolCRM</h2>
      <p style="margin: 0; font-size: 12px; color: #666;">Tu empresa S.A. - RUC: 80012345-6</p>
    </div>
    <div style="display: table-cell; width: 50%; text-align: right;">
      <h3 style="margin: 0; font-size: 18px;">FACTURA</h3>
      <p style="margin: 0; font-size: 14px;"><%= @factura[:numero] %></p>
    </div>
  </div>

  <!-- Datos Cliente -->
  <div style="margin-bottom: 20px;">
    <p><b>Cliente:</b> <%= @cliente ? @cliente[:nombre] : '—' %></p>
    <p><b>Fecha:</b> <%= @factura[:fecha] %> | <b>Estado:</b> <%= @factura[:estado].upcase %></p>
  </div>

  <!-- Tabla de Ítems -->
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
    <thead>
      <tr>
        <th style="text-align: left; border-bottom: 1px solid #ddd; padding: 8px;">Descripción</th>
        <th style="text-align: right; border-bottom: 1px solid #ddd; padding: 8px;">Cantidad</th>
        <th style="text-align: right; border-bottom: 1px solid #ddd; padding: 8px;">Precio Unit.</th>
        <th style="text-align: right; border-bottom: 1px solid #ddd; padding: 8px;">Total</th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |it| %>
        <tr>
          <td style="border-bottom: 1px solid #eee; padding: 8px;"><%= it[:descripcion] %></td>
          <td style="text-align: right; border-bottom: 1px solid #eee; padding: 8px;"><%= it[:cantidad].to_i %></td>
          <td style="text-align: right; border-bottom: 1px solid #eee; padding: 8px;">₲ <%= number_with_delimiter(it[:precio]) %></td>
          <td style="text-align: right; border-bottom: 1px solid #eee; padding: 8px;">₲ <%= number_with_delimiter(it[:total]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- Totales -->
  <div style="display: table; width: 100%;">
    <div style="display: table-cell; width: 60%;"></div>
    <div style="display: table-cell; width: 40%; text-align: right;">
      <p style="margin: 5px 0;">Subtotal: ₲ <%= number_with_delimiter(@factura[:subtotal]) %></p>
      <p style="margin: 5px 0;">IVA (10%): ₲ <%= number_with_delimiter(@factura[:impuestos]) %></p>
      <h3 style="margin: 10px 0; font-size: 18px;">Total: ₲ <%= number_with_delimiter(@factura[:total]) %></h3>
    </div>
  </div>

  <% if @factura[:notas] && !@factura[:notas].empty? %>
    <div style="margin-top: 30px; padding: 15px; background: #f9f9f9; border-left: 4px solid #ccc;">
      <b>Notas:</b> <%= @factura[:notas] %>
    </div>
  <% end %>

</body>
</html>