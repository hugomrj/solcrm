<meta charset="UTF-8">

<!-- Encabezado solo para PDF / Impresión -->
<div class="print-only" style="display: none; margin-bottom: 30px;">
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px;">
    <div>
      <h2 style="margin: 0; font-size: 24px;">SolCRM</h2>
      <p style="margin: 0; font-size: 12px; color: #666;">Tu empresa S.A. - RUC: 80012345-6</p>
    </div>
    <div style="text-align: right;">
      <h3 style="margin: 0; font-size: 18px;">FACTURA</h3>
      <p style="margin: 0; font-size: 14px;"><%= @factura[:numero] %></p>
    </div>
  </div>
</div>

<a href="<%= t('/ventas/facturas') %>" class="backlink"><i data-lucide="arrow-left"></i> Volver a facturas</a>

<% saldo = saldo_factura(@factura) %>

<div class="page-head" style="margin-bottom: 24px;">
  <div>
    <h1>Factura <%= @factura[:numero] %></h1>
    <p class="sub" style="display:flex; align-items:center; gap:8px;">
      <%= @cliente ? @cliente[:nombre] : '—' %> 
      <span style="color:var(--border-strong)">|</span> 
      <%= @factura[:fecha] %>
      <span class="badge <%= @factura[:estado] == 'borrador' ? 'b-gray' : (@factura[:estado] == 'pagada' ? 'b-green' : 'b-blue') %>" style="margin-left:8px">
        <%= @factura[:estado] %>
      </span>
    </p>
  </div>
  <div class="head-actions" style="display:flex;gap:8px">

    <% if params[:origen] == "factura" %>
      <a href="<%= t('/ventas/facturas/nuevo') %>" class="btn btn-primary">
        <i data-lucide="plus"></i> Nueva factura
      </a>
    <% end %>

    <!-- Botón para imprimir / generar PDF -->
    <a href="<%= t("/ventas/facturas/#{@factura[:id]}/pdf") %>" target="_blank" class="btn btn-ghost">
      <i data-lucide="printer"></i> Imprimir PDF
    </a>

    <% if @factura[:estado] == "borrador" %>
      <a href="<%= t("/ventas/facturas/#{@factura[:id]}/editar") %>" class="btn btn-ghost"><i data-lucide="pencil"></i> Editar</a>
      <form method="post" action="<%= t("/ventas/facturas/#{@factura[:id]}/estado") %>" style="display:inline">
        <input type="hidden" name="estado" value="emitida">
        <button type="submit" class="btn btn-primary"><i data-lucide="send"></i> Emitir</button>
      </form>
    <% elsif %w[emitida pagada].include?(@factura[:estado]) && saldo > 0.009 %>
      <a href="<%= t("/ventas/notas_credito/nuevo?factura_id=#{@factura[:id]}") %>" class="btn btn-ghost">
        <i data-lucide="rotate-ccw"></i> Nota de crédito
      </a>
      <a href="<%= t("/ventas/pagos/nuevo?factura_id=#{@factura[:id]}") %>" class="btn btn-primary">
        <i data-lucide="credit-card"></i> Registrar pago
      </a>
    <% end %>
    
  </div>
</div>

<div class="card" style="padding: 24px 28px;">
  
  <div class="table-wrap">
    <table style="margin-bottom: 24px;">
      <thead>
        <tr>
          <th>Descripción</th>
          <th style="text-align:right">Cantidad</th>
          <th style="text-align:right">Precio Unit.</th>
          <th style="text-align:right">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |it| %>
          <tr>
            <td><%= it[:descripcion] %></td>
            <td style="text-align:right"><%= numero_input(it[:cantidad]) %></td>
            <td style="text-align:right">₲ <%= number_with_delimiter(it[:precio]) %></td>
            <td style="text-align:right;font-weight:600">₲ <%= number_with_delimiter(it[:total]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div style="border-top: 1px solid var(--border); padding-top: 24px; margin-top: 8px; display: flex; justify-content: flex-end;">
    
    <div style="width: 300px;">
      <div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:14px; color:var(--text-2);">
        <span>Subtotal:</span>
        <span style="font-variant-numeric: tabular-nums;">₲ <%= number_with_delimiter(@factura[:subtotal]) %></span>
      </div>
      
      <div style="display:flex; justify-content:space-between; margin-bottom:16px; font-size:14px; color:var(--text-2);">
        <span>IVA (10%):</span>
        <span style="font-variant-numeric: tabular-nums;">₲ <%= number_with_delimiter(@factura[:impuestos]) %></span>
      </div>
      
      <div style="display:flex; justify-content:space-between; font-size:18px; font-weight:700; color:var(--text); border-top:1px solid var(--border); padding-top:16px;">
        <span>Total:</span>
        <span style="font-variant-numeric: tabular-nums;">₲ <%= number_with_delimiter(@factura[:total]) %></span>
      </div>
    </div>

  </div>

  <% if @factura[:notas] && !@factura[:notas].empty? %>
    <div style="margin-top: 32px; padding: 16px; background: var(--surface-2); border-radius: 9px; border: 1px solid var(--border); font-size: 13.5px; color: var(--text-2); line-height: 1.6;">
      <b style="color:var(--text);">Notas de la factura:</b><br>
      <%= @factura[:notas] %>
    </div>
  <% end %>

</div>

<% if @factura[:estado] == "borrador" %>
<div class="card" style="padding: 24px 28px; margin-top: 16px;">
  <h3 style="margin:0 0 6px; font-size:15px;">Cobranza</h3>
  <p class="sub" style="margin:0;">Emití la factura para poder registrar cobros o notas de crédito.</p>
</div>
<% else %>
<div class="card" style="padding: 24px 28px; margin-top: 16px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h3 style="margin:0; font-size:15px;">Cobranza</h3>
    <% if saldo > 0.009 %>
      <span class="badge b-warn">Saldo pendiente: ₲ <%= number_with_delimiter(saldo) %></span>
    <% else %>
      <span class="badge b-green">Cobrada en su totalidad</span>
    <% end %>
  </div>

  <div style="display:flex; gap:32px; flex-wrap:wrap; margin-bottom:20px; font-size:13.5px; color:var(--text-2);">
    <div>
      <div class="sub" style="font-size:12px;">Cobrado</div>
      <div style="font-weight:600; font-variant-numeric:tabular-nums;">₲ <%= number_with_delimiter(total_pagado_factura(@factura[:id])) %></div>
    </div>
    <div>
      <div class="sub" style="font-size:12px;">Acreditado</div>
      <div style="font-weight:600; font-variant-numeric:tabular-nums;">₲ <%= number_with_delimiter(total_notas_factura(@factura[:id])) %></div>
    </div>
    <div>
      <div class="sub" style="font-size:12px;">Saldo</div>
      <div style="font-weight:600; font-variant-numeric:tabular-nums;">₲ <%= number_with_delimiter(saldo) %></div>
    </div>
  </div>

  <% if @pagos.empty? && @notas.empty? %>
    <p class="sub" style="margin:0;">Todavía no hay pagos ni notas de crédito para esta factura.</p>
  <% end %>

  <% unless @pagos.empty? %>
    <h4 style="margin:0 0 8px; font-size:13px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-3);">Pagos</h4>
    <div class="table-wrap" style="margin-bottom:20px;">
      <table>
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Método</th>
            <th>Referencia</th>
            <th style="text-align:right">Monto</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @pagos.each do |p| %>
            <tr>
              <td><%= p[:fecha] %></td>
              <td><span class="badge b-blue"><%= p[:metodo] %></span></td>
              <td><span class="sub"><%= p[:referencia] && !p[:referencia].empty? ? p[:referencia] : '—' %></span></td>
              <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:600;">₲ <%= number_with_delimiter(p[:monto]) %></td>
              <td>
                <div class="row-actions">
                  <a href="<%= t("/ventas/pagos/#{p[:id]}") %>" class="icon-act" title="Ver pago"><i data-lucide="eye"></i></a>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% unless @notas.empty? %>
    <h4 style="margin:0 0 8px; font-size:13px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-3);">Notas de crédito</h4>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Número</th>
            <th>Fecha</th>
            <th>Motivo</th>
            <th style="text-align:right">Monto</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @notas.each do |n| %>
            <tr>
              <td><b><%= n[:numero] %></b></td>
              <td><%= n[:fecha] %></td>
              <td><span class="sub"><%= n[:motivo] && !n[:motivo].empty? ? n[:motivo] : '—' %></span></td>
              <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:600;">₲ <%= number_with_delimiter(n[:monto]) %></td>
              <td>
                <div class="row-actions">
                  <a href="<%= t("/ventas/notas_credito/#{n[:id]}") %>" class="icon-act" title="Ver nota"><i data-lucide="eye"></i></a>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
<% end %>
