<a href="<%= t('/facturas') %>" class="backlink"><i data-lucide="arrow-left"></i> Volver a facturas</a>

<div class="page-head">
  <div>
    <h1><%= @page_title %></h1>
    <p class="sub">Datos de la factura e ítems</p>
  </div>
</div>

<form method="post" action="<%= @factura ? t("/facturas/#{@factura[:id]}") : t('/facturas') %>" id="facturaForm">
  <div class="card form-card">
    <div class="form-grid">

      <div class="field">
        <label>Cliente *</label>
        <select name="cliente_id" class="vanilla-select" required>
          <option value="">— Elegir —</option>
          <% @clientes.each do |c| %>
            <option value="<%= c[:id] %>" <%= 'selected' if @factura && @factura[:cliente_id] == c[:id] %>><%= c[:nombre] %></option>
          <% end %>
        </select>
      </div>

      <div class="field">
        <label>Fecha de Emisión</label>
        <input type="date" name="fecha" value="<%= @factura ? @factura[:fecha] : Date.today %>">
      </div>
      
      <input type="hidden" name="estado" value="<%= @factura ? @factura[:estado] : 'borrador' %>">

      <div class="field span2" style="flex-direction:row; align-items:center; gap:10px; margin-top:8px;">
        <label style="margin:0;">¿Tiene vencimiento?</label>
        <input type="date" name="vencimiento" value="<%= @factura && @factura[:vencimiento] ? @factura[:vencimiento] : '' %>" style="width:200px;">
      </div>

    </div>
  </div>

  <div class="card form-card" style="margin-top:16px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <h3 style="margin:0; font-size:15px;">Ítems de la factura</h3>
      <button type="button" class="btn btn-ghost btn-sm" onclick="addItemRow()">
        <i data-lucide="plus"></i> Agregar ítem
      </button>
    </div>

    <div class="items-grid-header">
      <div>Artículo / Descripción</div>
      <div>Cant.</div>
      <div>Precio Unit.</div>
      <div>Total</div>
      <div></div>
    </div>

    <div id="itemsContainer"></div>

    <div class="invoice-totals">
      <div class="invoice-totals-inner">
        <div class="invoice-totals-row">
          <span>Subtotal:</span>
          <span>₲ <span id="subtotal">0</span></span>
        </div>
        <div class="invoice-totals-row">
          <span>IVA (10%):</span>
          <span>₲ <span id="impuestos">0</span></span>
        </div>
        <div class="invoice-totals-row grand-total">
          <span>Total:</span>
          <span>₲ <span id="total">0</span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="form-foot">
    <a href="<%= t('/facturas') %>" class="btn btn-ghost">Cancelar</a>
    <div class="spacer"></div>
    <button type="submit" class="btn btn-primary">
      <%= @factura ? 'Guardar cambios' : 'Crear factura' %>
    </button>
  </div>
</form>

<template id="itemRowTpl">
  <div class="item-row">
    <div class="field">
      <input type="hidden" name="items[__i__][descripcion]" class="item-desc">
      <select name="items[__i__][articulo_id]" class="vanilla-select">
        <option value="">— Elegir artículo —</option>
        <% @articulos.each do |a| %>
          <option value="<%= a[:id] %>" data-precio="<%= a[:precio] %>" data-nombre="<%= a[:nombre] %>"><%= a[:nombre] %></option>
        <% end %>
      </select>
    </div>
    <div class="field">
      <input type="number" name="items[__i__][cantidad]" value="1" min="0.01" step="0.01" class="item-cant">
    </div>
    <div class="field">
      <input type="number" name="items[__i__][precio]" value="0" min="0" step="0.01" class="item-precio">
    </div>
    <div class="field">
      <input type="text" class="item-total" value="0" readonly>
    </div>
    <button type="button" class="icon-act danger" onclick="this.closest('.item-row').remove(); window.recalc();">
      <i data-lucide="trash-2"></i>
    </button>
  </div>
</template>

<script>
  window.itemsIniciales = <%= (@items || []).map { |it| { descripcion: it[:descripcion], cantidad: it[:cantidad], precio: it[:precio], articulo_id: it[:articulo_id] } }.to_json %>;
</script>
<script src="/js/app/facturas.js" defer></script>