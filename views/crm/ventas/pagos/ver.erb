<a href="<%= t('/ventas/pagos') %>" class="backlink"><i data-lucide="arrow-left"></i> Volver a pagos</a>

<div class="page-head" style="margin-bottom:24px">
  <div>
    <h1>Pago #<%= @pago[:id] %></h1>
    <p class="sub" style="display:flex;align-items:center;gap:8px">
      <%= @cliente ? @cliente[:nombre] : '—' %>
      <span style="color:var(--border-strong)">|</span>
      <%= @pago[:fecha] %>
      <span class="badge b-blue" style="margin-left:8px"><%= @pago[:metodo] %></span>
    </p>
  </div>
  <div class="head-actions" style="display:flex;gap:8px">
    <% if @factura %>
      <a href="<%= t("/ventas/facturas/#{@factura[:id]}") %>" class="btn btn-ghost">
        <i data-lucide="file-check"></i> Ver factura
      </a>
    <% end %>
  </div>
</div>

<div class="card" style="padding:24px 28px">
  <div class="table-wrap">
    <table>
      <tbody>
        <tr>
          <th style="width:200px">Monto</th>
          <td style="font-weight:700;font-variant-numeric:tabular-nums">₲ <%= number_with_delimiter(@pago[:monto]) %></td>
        </tr>
        <tr>
          <th>Factura</th>
          <td>
            <% if @factura %>
              <a href="<%= t("/ventas/facturas/#{@factura[:id]}") %>"><b><%= @factura[:numero] %></b></a>
            <% else %>
              <span class="sub">Sin factura asociada</span>
            <% end %>
          </td>
        </tr>
        <tr>
          <th>Cliente</th>
          <td><%= @cliente ? @cliente[:nombre] : '—' %></td>
        </tr>
        <tr>
          <th>Fecha</th>
          <td><%= @pago[:fecha] %></td>
        </tr>
        <tr>
          <th>Método</th>
          <td><%= @pago[:metodo] %></td>
        </tr>
        <tr>
          <th>Referencia</th>
          <td><%= @pago[:referencia] && !@pago[:referencia].empty? ? @pago[:referencia] : '—' %></td>
        </tr>
        <tr>
          <th>Notas</th>
          <td><%= @pago[:notas] && !@pago[:notas].empty? ? @pago[:notas] : '—' %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
