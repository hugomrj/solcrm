<a href="<%= t('/stock') %>" class="backlink"><i data-lucide="arrow-left"></i> Volver a stock</a>

<div class="page-head">
  <div>
    <h1>Nuevo movimiento</h1>
    <p class="sub">Entrada o salida de mercadería</p>
  </div>
</div>

<form method="post" action="<%= t('/stock/movimientos') %>">
  <div class="card form-card">
    <div class="form-grid">

      <div class="field span2">
        <label>Artículo *</label>
        <select name="articulo_id" class="vanilla-select" required>
          <option value="">— Elegir artículo —</option>
          <% @articulos.each do |a| %>
            <option value="<%= a[:id] %>" <%= 'selected' if @articulo_id.to_s == a[:id].to_s %>>
              <%= a[:nombre] %> — stock actual <%= numero_input(@stock[a[:id]].to_f) %>
            </option>
          <% end %>
        </select>
      </div>

      <div class="field">
        <label>Tipo *</label>
        <select name="tipo" class="vanilla-select" required>
          <option value="entrada">Entrada (suma)</option>
          <option value="salida">Salida (resta)</option>
        </select>
      </div>

      <div class="field">
        <label for="cantidad">Cantidad *</label>
        <input type="number" id="cantidad" name="cantidad" min="0.01" step="0.01" required placeholder="0">
      </div>

      <div class="field span2">
        <label for="referencia">Referencia</label>
        <input type="text" id="referencia" name="referencia" placeholder="Nº de remito, factura de compra, etc.">
      </div>

      <div class="field span2">
        <label for="motivo">Motivo</label>
        <textarea id="motivo" name="motivo"></textarea>
      </div>

    </div>

    <div class="form-foot">
      <a href="<%= t('/stock') %>" class="btn btn-ghost">Cancelar</a>
      <div class="spacer"></div>
      <button type="submit" class="btn btn-primary">Registrar movimiento</button>
    </div>
  </div>
</form>
