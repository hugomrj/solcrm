<div class="page-head">
  <div>
    <h1>Ajustes de inventario</h1>
    <p class="sub">Corregí el stock contra el conteo físico</p>
  </div>
  <div class="head-actions">
    <a href="<%= t('/stock') %>" class="btn btn-ghost">
      <i data-lucide="layers"></i> Ver stock
    </a>
  </div>
</div>

<form method="post" action="<%= t('/ajustes_inventario') %>">
  <div class="card form-card">
    <div class="form-grid">

      <div class="field span2">
        <label>Artículo *</label>
        <select name="articulo_id" class="vanilla-select" required>
          <option value="">— Elegir artículo —</option>
          <% @articulos.each do |a| %>
            <option value="<%= a[:id] %>">
              <%= a[:nombre] %> — sistema: <%= numero_input(@stock[a[:id]].to_f) %>
            </option>
          <% end %>
        </select>
      </div>

      <div class="field">
        <label for="stock_real">Stock contado *</label>
        <input type="number" id="stock_real" name="stock_real" min="0" step="0.01" required placeholder="0">
        <span class="msg"></span>
      </div>

      <div class="field">
        <label for="motivo">Motivo</label>
        <input type="text" id="motivo" name="motivo" placeholder="Rotura, faltante, recuento…">
      </div>

    </div>

    <div class="form-foot">
      <a href="<%= t('/stock') %>" class="btn btn-ghost">Cancelar</a>
      <div class="spacer"></div>
      <button type="submit" class="btn btn-primary">Aplicar ajuste</button>
    </div>
  </div>
</form>

<div class="card" style="margin-top:16px">
  <% if @ajustes.empty? %>
    <div class="empty">
      <i data-lucide="sliders-horizontal"></i>
      <b>Sin ajustes registrados</b>
      <p>Cuando el conteo físico no coincida con el sistema, corregilo desde acá</p>
    </div>
  <% else %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Artículo</th>
            <th style="text-align:right">Diferencia</th>
            <th>Motivo</th>
          </tr>
        </thead>
        <tbody>
          <% @ajustes.each do |m| %>
            <% art = @articulos_por_id[m[:articulo_id]] %>
            <% dif = m[:cantidad].to_f %>
            <tr>
              <td><%= m[:created_at].strftime("%d/%m/%Y %H:%M") %></td>
              <td><%= art ? art[:nombre] : '—' %></td>
              <td style="text-align:right;font-variant-numeric:tabular-nums;font-weight:600;">
                <span class="badge <%= dif >= 0 ? 'b-green' : 'b-red' %>"><%= dif >= 0 ? '+' : '' %><%= numero_input(dif) %></span>
              </td>
              <td><span class="sub"><%= m[:motivo] && !m[:motivo].empty? ? m[:motivo] : '—' %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
